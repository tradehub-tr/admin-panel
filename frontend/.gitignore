# ── Build Çıktıları ───────────────────────────────────────────────────────────
dist/
dist-ssr/

# ── Bağımlılıklar ─────────────────────────────────────────────────────────────
node_modules/
.cache/
.npm/
.eslintcache

# ── Environment Dosyaları ─────────────────────────────────────────────────────
# .env.development ve .env.production paylaşılabilir
# Sadece kişisel override dosyaları ignore edilir
.env
.env.local
.env.*.local

# ── Vite Geliştirme ───────────────────────────────────────────────────────────
*.local

# ── Log Dosyaları ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS Dosyaları ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test / Coverage ───────────────────────────────────────────────────────────
coverage/

# ── Auto Claude ───────────────────────────────────────────────────────────────
.auto-claude/
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key

# Storybook statik çıktısı
storybook-static

# ── Playwright E2E ────────────────────────────────────────────────────────────
# Test çalıştırıcı çıktıları + tarayıcı oturum durumu (sid cookie taşır — commit'lenmez).
test-results/
playwright-report/
# Playwright kanıt çıktısı: her koşuda yeniden üretiliyor. `evidence/*` biçimi
# bilinçli — `evidence/` yazsaydık git dizine hiç inmez ve muafiyet çalışmazdı.
playwright/evidence/*
# İSTİSNA: medya görevlerinin BİLİNÇLİ commit'lediği görsel regresyon kanıtı.
# İzlenen tek kanıt kümesi bu; storefront'ta da aynı kural duruyor.
!playwright/evidence/media-*/
playwright/.auth/
blob-report/
.playwright/
