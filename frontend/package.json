{
  "name": "tr-tradehub-frontend",
  "version": "1.13.4-alpha.18",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "lint:fix": "eslint \"src/**/*.{js,vue}\" --fix && prettier --write \"src/**/*.{js,vue,json,css,scss}\"",
    "format": "prettier --write \"src/**/*.{js,vue,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,json,css,scss}\"",
    "test": "node --test \"src/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/**/*.test.js\"",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "parity:crop": "node scripts/sync-crop-geometry.mjs --check && node --test src/lib/media/crop/__tests__/*.test.js",
    "sync:crop": "node scripts/sync-crop-geometry.mjs",
    "sync:crop:check": "node scripts/sync-crop-geometry.mjs --check",
    "sync:simulator": "node scripts/sync-simulator.mjs",
    "sync:simulator:check": "node scripts/sync-simulator.mjs --check",
    "sync:policy": "node scripts/sync-policy-engine.mjs",
    "sync:policy:check": "node scripts/sync-policy-engine.mjs --check",
    "sync:api": "node scripts/sync-api-types.mjs",
    "sync:api:check": "node scripts/sync-api-types.mjs --check",
    "contract:api": "ISTOC_CONTRACT=1 node --test src/lib/api/__tests__/contract.live.test.js",
    "parity:policy": "node scripts/sync-policy-engine.mjs --check && node --test src/lib/media/policy/__tests__/*.test.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "dompurify": "^3.2.4",
    "echarts": "^5.5.0",
    "hls.js": "^1.7.1",
    "lucide-vue-next": "^0.577.0",
    "mediabunny": "^1.53.1",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.4.0",
    "vuedraggable": "^4.1.0",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.62.1",
    "@stoplight/spectral-cli": "^6.16.3",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/vue3-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^5.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.31.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.0",
    "sass": "^1.97.3",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.1.18",
    "vite": "^5.4.0"
  }
}
